# Copia este archivo a `.env` y completa los valores. Nunca subas `.env` al repositorio.

# --- Base de datos (obligatoria) ---
# Cadena de conexión de PostgreSQL (Prisma). Ejemplo local; sustituye usuario, clave y base.
DATABASE_URL="postgresql://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/proyecto_comex?schema=public"
# Conexión directa que usa Prisma para migrar (`prisma migrate`). Obligatoria para Prisma CLI.
# En local es igual a DATABASE_URL.
# En Supabase: DATABASE_URL es el pooler (puerto 6543, añade `?pgbouncer=true`) y DIRECT_URL es la
# conexión directa (puerto 5432). Cópialas desde Project Settings > Database > Connection string.
DIRECT_URL="postgresql://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/proyecto_comex?schema=public"

# --- Autenticación (obligatorias) ---
# Secreto para firmar los JWT: mínimo 32 caracteres y sin valor por defecto.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Vigencia del token en segundos (por ejemplo 3600 = 1 hora).
JWT_EXPIRES_IN=3600

# --- Servidor ---
# Puerto HTTP (por defecto 3001).
PORT=3001
# Orígenes permitidos por CORS, separados por comas (los del frontend local y el desplegado).
CORS_ORIGINS="http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500"

# --- Imágenes del catálogo en Supabase Storage (el bucket S3) ---
# Opcionales: sin ellas la API funciona, pero subir una imagen responde 503.
# SUPABASE_URL="https://TU-PROYECTO.supabase.co"
# Llave de servicio: solo en el backend, jamás en el frontend ni en GitHub.
# SUPABASE_SERVICE_ROLE_KEY=
# Bucket público donde se guardan las imágenes (por defecto "catalogo").
SUPABASE_STORAGE_BUCKET="catalogo"

# --- Seed (npm run db:seed) ---
# Opcionales. Sin ellas se crean admin@colcomex.com / Admin#2026 y usuario@colcomex.com / Usuario#2026.
# Son cuentas de demostración: cambia estos valores en cualquier entorno real.
# El seed no modifica una cuenta cuyo correo ya existe.
# SEED_ADMIN_NAME="Administrador"
# SEED_ADMIN_EMAIL="admin@colcomex.com"
# SEED_ADMIN_PASSWORD="Admin#2026"
# SEED_USER_NAME="Usuario de prueba"
# SEED_USER_EMAIL="usuario@colcomex.com"
# SEED_USER_PASSWORD="Usuario#2026"
